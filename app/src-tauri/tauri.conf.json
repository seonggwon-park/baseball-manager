{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Baseball Manager",
  "version": "0.1.0",
  "identifier": "dev.baseballmanager.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Baseball Manager",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Baseball management simulation",
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["Korean", "English"] }
    }
  }
}
